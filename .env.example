# GEMINI_API_KEY: Required if Gemini AI features are invoked server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (set automatically in AI Studio).
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Authentication Configuration
# Configure these in Settings -> Secrets before signing in or writing database records.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication & Admin Bootstrap Configuration
AUTH_REDIRECT_URL=http://localhost:3000/#/reset-password
ADMIN_BOOTSTRAP_EMAIL=

# Future Payment Provider Integration (KEEP DISABLED UNTIL LEGALLY AUTHORIZED)
PAYMENT_MODE=DEMO_ONLY
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CRYPTO_CUSTODY_API_KEY=
MOBILE_MONEY_API_KEY=
